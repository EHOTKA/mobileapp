<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Игровой вид будет добавлен сюда программно -->

    <!-- Панель статистики -->
    <LinearLayout
        android:id="@+id/statsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_panel"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Очки"
                android:textColor="@color/emerald_600"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/emerald_700"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Бонус"
                android:textColor="@color/emerald_600"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/10"
                android:textColor="@color/emerald_700"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Монеты"
                android:textColor="#facc15"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#b45309"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Жизни"
                android:textColor="#ef4444"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#b91c1c"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Полоска Модификатора -->
    <LinearLayout
        android:id="@+id/modifierContainer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvModifierName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="МОДИФИКАТОР"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#000"
            android:shadowRadius="4" />
        <ProgressBar
            android:id="@+id/pbModifier"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/modifier_progress_bg"
            android:max="100"
            android:progress="0" />
    </LinearLayout>

    <!-- Кнопка паузы в игре -->
    <ImageButton
        android:id="@+id/btnPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_panel"
        android:elevation="8dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_pause"
        android:visibility="gone" />

    <!-- Комбо-текст -->
    <TextView
        android:id="@+id/tvCombo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="180dp"
        android:elevation="10dp"
        android:text="COMBO X2!"
        android:textColor="#facc15"
        android:textSize="32sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Уведомление о +1 Жизни или Монетах -->
    <LinearLayout
        android:id="@+id/lifeNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="110dp"
        android:background="@drawable/glass_panel"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivNotifIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/heart" />

        <TextView
            android:id="@+id/tvNotifText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+1 Жизнь!"
            android:textColor="#ef4444"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Уведомление о Ускорении -->
    <TextView
        android:id="@+id/speedUpNotif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="20dp"
        android:text="УСКОРЕНИЕ!"
        android:textColor="#facc15"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8" />

    <!-- Стартовый экран -->
    <FrameLayout
        android:id="@+id/startScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/emerald_900_40"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:rotation="-6"
                android:src="@android:drawable/ic_menu_send" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="ПОЧТАЛЬОН\nДРАЙВ"
                android:textColor="@color/emerald_700"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHighScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="РЕКОРД: 0"
                android:textColor="@color/emerald_600"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="МОНЕТЫ: 0"
                android:textColor="#b45309"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:text="Доставь все газеты вовремя!"
                android:textColor="@color/emerald_600"
                android:alpha="0.8" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/emerald_500"
                android:text="ИГРАТЬ"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <Button
                android:id="@+id/btnShop"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#facc15"
                android:text="МАГАЗИН"
                android:textColor="#854d0e"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Экран магазина -->
    <FrameLayout
        android:id="@+id/shopScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6064e3b"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="МАГАЗИН"
                android:textColor="@color/emerald_700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvShopCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="МОНЕТЫ: 0"
                android:textColor="#b45309"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- Карточка товара: Удвоение -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A000000"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/paper" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Удвоение"
                        android:textColor="#333"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x2 монет и жизней на 30 сек"
                        android:textSize="10sp"
                        android:textColor="#666" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBuyDouble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 🪙"
                    android:backgroundTint="@color/emerald_500"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCloseShop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#666"
                android:text="НАЗАД"
                android:textColor="@android:color/white"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Экран паузы -->
    <FrameLayout
        android:id="@+id/pauseScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="ПАУЗА"
                android:textColor="@color/emerald_700"
                android:textSize="40sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/emerald_500"
                android:text="ПРОДОЛЖИТЬ"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <Button
                android:id="@+id/btnToMenu"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#666666"
                android:text="В МЕНЮ"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Экран Game Over -->
    <FrameLayout
        android:id="@+id/gameOverScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99ef4444"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОЙ!"
                android:textColor="#ef4444"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Игра окончена. Твой результат:"
                android:textColor="#666" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="0"
                android:textColor="@color/emerald_600"
                android:textSize="64sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#ef4444"
                android:text="ПОВТОРИТЬ"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
